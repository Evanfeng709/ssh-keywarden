{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSH Keywarden",
  "version": "0.4.0",
  "identifier": "io.github.evanfeng709.ssh-keywarden",
  "build": {
    "frontendDist": "../../assets/public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../../assets/public": "public/"
    }
  }
}
